{
  "name": "dots-wrapper",
  "version": "3.12.11",
  "description": "Digital Ocean v2 api wrapper - javascript - typescript - nodejs",
  "main": "dist/index.js",
  "browser": "dist/index-browser.min.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:browser": "webpack --mode=production",
    "build:test": "jest --silent",
    "build": "rm -rf ./dist && tsc",
    "install_latest_dev": "npm install --save-dev @types/jest@latest @types/node@latest jest@latest license-webpack-plugin@latest ts-jest@latest @typescript/native@npm:typescript@latest typescript@npm:@typescript/typescript6@latest webpack@latest webpack-cli@latest",
    "install_latest": "npm install --save axios@latest",
    "test": "export TEST_TOKEN=bearer-token && jest",
    "version": "npm version --no-git-tag-version "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pjpimentel/dots.git"
  },
  "author": "Pedro J. Pimentel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pjpimentel/dots/issues"
  },
  "homepage": "https://dots.pimentel.co",
  "files": [
    "dist"
  ],
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.1",
    "license-webpack-plugin": "^4.0.2",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "keywords": [
    "api",
    "cloud",
    "digital ocean",
    "digital-ocean",
    "digital",
    "digitalocean",
    "ocean",
    "sdk",
    "wrapper"
  ],
  "funding": [
    "https://github.com/pjpimentel/dots?sponsor=1"
  ]
}
